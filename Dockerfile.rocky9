# syntax=docker/dockerfile:1.7
# =============================================================================
# ContainerizedCPP Development Container — Rocky Linux 9
#
# dnf-first dependency strategy:
# - Use BaseOS/AppStream/EPEL 9 packages where available.
# - Build from source: Protobuf, Asio, FastCDR/DDS, fastddsgen, gRPC,
#   iceoryx, CycloneDDS (C+CXX), CZMQ, Zyre, Crow.
# - Compiler: GCC 13 via gcc-toolset-13 (AppStream) — activated via PATH.
#
# Rocky 9 vs Ubuntu 24.04 delta:
#   Rocky 9 ships protobuf 3.14 (too old), no gRPC, no FastDDS, no iceoryx,
#   no CycloneDDS, no CZMQ in base — all are source-built here.
#   spdlog, zeromq/cppzmq, re2, tinyxml2, lcov, gtest are available in EPEL 9.
#
# Build:
#   docker build -f Dockerfile.rocky9 -t containerizedcpp-dev-rocky9 .
#
# Run:
#   docker run -v $(pwd):/workspace -w /workspace -it containerizedcpp-dev-rocky9
#
# Build inside container:
#   cmake --preset container-debug
#   cmake --build --preset container-debug
#   ctest --preset container-debug
# =============================================================================

FROM rockylinux:9

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# ---- Source-build version pins -----------------------------------------------
ARG PROTOBUF_VERSION=3.21.12
ARG GRPC_VERSION=v1.51.3
ARG ASIO_VERSION=asio-1-30-2
ARG FASTCDR_VERSION=v1.0.28
ARG FASTDDS_VERSION=v2.14.4
ARG FOONATHAN_MEMORY_VERSION=vendor-1.4.1
ARG FASTDDSGEN_VERSION=v3.3.0
ARG ICEORYX_VERSION=v2.0.6
ARG CYCLONEDDS_VERSION=0.10.5
ARG CYCLONEDDS_CXX_VERSION=0.10.5
ARG CZMQ_VERSION=v4.2.1
ARG ZYRE_VERSION=v2.0.1
ARG CROW_VERSION=v1.2.0

# ---- Base environment --------------------------------------------------------
ENV CONTAINERIZEDCPP_CONTAINER_BUILD=1
ENV CMAKE_PREFIX_PATH=/usr/local:/usr
ENV PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:/usr/local/lib64/pkgconfig:/usr/lib64/pkgconfig
ENV IMAGE_DEFAULT_CC=gcc
ENV IMAGE_DEFAULT_CXX=g++

# Rocky 9's default ldconfig config does not search /usr/local/lib{,64}, and
# some source-built shared libs here (e.g. Fast-DDS) do not embed their own
# RPATH for transitive dependencies (e.g. foonathan_memory) — without this,
# any executable linking them fails at runtime with "shared object not found"
# even though the .so files are present.
RUN printf '/usr/local/lib\n/usr/local/lib64\n' > /etc/ld.so.conf.d/usrlocal.conf

# ---- Enable EPEL and CRB (CodeReady Builder — equiv. of Ubuntu Universe) -----
RUN --mount=type=cache,target=/var/cache/dnf,sharing=locked \
   dnf install -y epel-release dnf-plugins-core \
   && dnf config-manager --set-enabled crb \
   && dnf update -y

# ---- Compiler: GCC 13 via gcc-toolset-13 (AppStream) ------------------------
RUN --mount=type=cache,target=/var/cache/dnf,sharing=locked \
   dnf install -y \
   gcc-toolset-13 \
   gcc-toolset-13-gcc \
   gcc-toolset-13-gcc-c++ \
   gcc-toolset-13-binutils \
   gcc-toolset-13-libatomic-devel \
   gcc-toolset-13-libasan-devel \
   gcc-toolset-13-libubsan-devel

# Activate gcc-toolset-13 for all subsequent RUN layers and runtime
ENV PATH=/opt/rh/gcc-toolset-13/root/usr/bin:$PATH
ENV LD_LIBRARY_PATH=/opt/rh/gcc-toolset-13/root/usr/lib64

# ---- Build tools and dnf library dependencies --------------------------------
RUN --mount=type=cache,target=/var/cache/dnf,sharing=locked \
   dnf install -y \
   cmake \
   ninja-build \
   make \
   python3 \
   python3-pip \
   git \
   ca-certificates \
   pkgconfig \
   wget \
   unzip \
   perl \
   java-11-openjdk \
   openssl-devel \
   zlib-devel \
   libacl-devel \
   systemd-devel \
   tinyxml2-devel \
   spdlog-devel \
   re2-devel \
   c-ares-devel \
   zeromq-devel \
   cppzmq-devel \
   lcov

RUN if [ ! -e /usr/bin/ninja-build ]; then ln -s /usr/bin/ninja /usr/bin/ninja-build; fi

# gcovr via pip (EPEL 9 version may be too old)
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
   pip3 install gcovr

# ---- GoogleTest (not reliably packaged for Rocky 9) ------------------------
RUN git clone --depth 1 --branch v1.14.0 \
   https://github.com/google/googletest.git /tmp/googletest \
   && cmake -S /tmp/googletest -B /tmp/googletest/build -G Ninja \
   -DCMAKE_BUILD_TYPE=Release \
   -DCMAKE_INSTALL_PREFIX=/usr/local \
   -DBUILD_GMOCK=ON \
   -Dgtest_build_tests=OFF \
   -Dgmock_build_tests=OFF \
   && cmake --build /tmp/googletest/build \
   && cmake --install /tmp/googletest/build \
   && rm -rf /tmp/googletest

# ---- LLVM tools: clangd and clang-tidy (AppStream llvm-toolset) --------------
RUN --mount=type=cache,target=/var/cache/dnf,sharing=locked \
   dnf install -y clang-tools-extra

# ---- Protobuf 3.21.12 (Rocky 9 AppStream ships 3.14 — incompatible) ---------
RUN git clone --depth 1 --branch v${PROTOBUF_VERSION} \
   https://github.com/protocolbuffers/protobuf.git /tmp/protobuf \
   && cmake -S /tmp/protobuf -B /tmp/protobuf/build -G Ninja \
   -DCMAKE_BUILD_TYPE=Release \
   -DCMAKE_INSTALL_PREFIX=/usr/local \
   -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
   -Dprotobuf_BUILD_TESTS=OFF \
   -Dprotobuf_WITH_ZLIB=ON \
   && cmake --build /tmp/protobuf/build \
   && cmake --install /tmp/protobuf/build \
   && ldconfig \
   && rm -rf /tmp/protobuf

# ---- Asio headers (header-only, not packaged for RHEL/Rocky) -----------------
RUN git clone --depth 1 --branch ${ASIO_VERSION} \
   https://github.com/chriskohlhoff/asio.git /tmp/asio \
   && cp -r /tmp/asio/asio/include/asio /usr/local/include/ \
   && cp    /tmp/asio/asio/include/asio.hpp /usr/local/include/ \
   && rm -rf /tmp/asio

# ---- FastCDR 1.0.28 ----------------------------------------------------------
RUN git clone --depth 1 --branch ${FASTCDR_VERSION} \
   https://github.com/eProsima/Fast-CDR.git /tmp/fastcdr \
   && cmake -S /tmp/fastcdr -B /tmp/fastcdr/build -G Ninja \
   -DCMAKE_BUILD_TYPE=Release \
   -DCMAKE_INSTALL_PREFIX=/usr/local \
   -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
   && cmake --build /tmp/fastcdr/build \
   && cmake --install /tmp/fastcdr/build \
   && ldconfig \
   && rm -rf /tmp/fastcdr

# ---- foonathan_memory (required by Fast-DDS) --------------------------------
RUN git clone --depth 1 --branch ${FOONATHAN_MEMORY_VERSION} \
   https://github.com/eProsima/memory.git /tmp/foonathan_memory \
   && cmake -S /tmp/foonathan_memory -B /tmp/foonathan_memory/build -G Ninja \
   -DCMAKE_BUILD_TYPE=Release \
   -DCMAKE_INSTALL_PREFIX=/usr/local \
   -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
   -DBUILD_SHARED_LIBS=ON \
   -DFOONATHAN_MEMORY_BUILD_EXAMPLES=OFF \
   -DFOONATHAN_MEMORY_BUILD_TESTS=OFF \
   -DFOONATHAN_MEMORY_BUILD_TOOLS=OFF \
   && cmake --build /tmp/foonathan_memory/build \
   && cmake --install /tmp/foonathan_memory/build \
   && ldconfig \
   && rm -rf /tmp/foonathan_memory

# ---- FastDDS 2.14.4 (depends on FastCDR + Asio + tinyxml2) ------------------
RUN git clone --depth 1 --branch ${FASTDDS_VERSION} \
   https://github.com/eProsima/Fast-DDS.git /tmp/fastdds \
   && cmake -S /tmp/fastdds -B /tmp/fastdds/build -G Ninja \
   -DCMAKE_BUILD_TYPE=Release \
   -DCMAKE_INSTALL_PREFIX=/usr/local \
   -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
   -DBUILD_SHARED_LIBS=ON \
   -DCOMPILE_TOOLS=OFF \
   -DBUILD_DOCUMENTATION=OFF \
   && cmake --build /tmp/fastdds/build \
   && cmake --install /tmp/fastdds/build \
   && ldconfig \
   && rm -rf /tmp/fastdds

# ---- fastddsgen (built via Gradle wrapper — requires Java) -------------------
RUN --mount=type=cache,target=/root/.gradle,sharing=locked \
   git clone --depth 1 --branch ${FASTDDSGEN_VERSION} \
   https://github.com/eProsima/Fast-DDS-Gen.git /tmp/fastddsgen \
   && cd /tmp/fastddsgen \
   && ./gradlew assemble --no-daemon -q \
   && mkdir -p /usr/local/share/fastddsgen/java \
   && cp build/libs/fastddsgen.jar /usr/local/share/fastddsgen/java/ \
   && printf '#!/bin/bash\nexec java -jar /usr/local/share/fastddsgen/java/fastddsgen.jar "$@"\n' \
   > /usr/local/bin/fastddsgen \
   && chmod +x /usr/local/bin/fastddsgen \
   && rm -rf /tmp/fastddsgen

# ---- gRPC v1.51.3 (abseil bundled; protobuf/re2/c-ares/ssl from system) -----
RUN git clone --depth 1 --branch ${GRPC_VERSION} \
   https://github.com/grpc/grpc.git /tmp/grpc \
   && git -C /tmp/grpc submodule update --init --depth 1 -- \
   third_party/abseil-cpp \
   && cmake -S /tmp/grpc -B /tmp/grpc/build -G Ninja \
   -DCMAKE_BUILD_TYPE=Release \
   -DCMAKE_INSTALL_PREFIX=/usr/local \
   -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
   -DgRPC_INSTALL=ON \
   -DgRPC_BUILD_TESTS=OFF \
   -DgRPC_ABSL_PROVIDER=module \
   -DgRPC_PROTOBUF_PROVIDER=package \
   -DgRPC_RE2_PROVIDER=package \
   -DgRPC_CARES_PROVIDER=package \
   -DgRPC_SSL_PROVIDER=package \
   -DgRPC_ZLIB_PROVIDER=package \
   && cmake --build /tmp/grpc/build \
   && cmake --install /tmp/grpc/build \
   && ldconfig \
   && rm -rf /tmp/grpc

# ---- iceoryx 2.0.6 (shared-memory transport used by CycloneDDS) -------------
RUN git clone --depth 1 --branch ${ICEORYX_VERSION} \
   https://github.com/eclipse-iceoryx/iceoryx.git /tmp/iceoryx \
   && cmake -S /tmp/iceoryx/iceoryx_meta -B /tmp/iceoryx/build -G Ninja \
   -DCMAKE_BUILD_TYPE=Release \
   -DCMAKE_INSTALL_PREFIX=/usr/local \
   -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
   -DBUILD_TESTING=OFF \
   -DBUILD_EXAMPLES=OFF \
   && cmake --build /tmp/iceoryx/build \
   && cmake --install /tmp/iceoryx/build \
   && ldconfig \
   && rm -rf /tmp/iceoryx

# ---- CycloneDDS C 0.10.5 (not packaged for Rocky/RHEL) ----------------------
RUN git clone --depth 1 --branch ${CYCLONEDDS_VERSION} \
   https://github.com/eclipse-cyclonedds/cyclonedds.git /tmp/cyclonedds \
   && cmake -S /tmp/cyclonedds -B /tmp/cyclonedds/build -G "Unix Makefiles" \
   -DCMAKE_BUILD_TYPE=Release \
   -DCMAKE_INSTALL_PREFIX=/usr/local \
   -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
   -DBUILD_TESTING=OFF \
   -DBUILD_EXAMPLES=OFF \
   -DENABLE_LTO=OFF \
   && cmake --build /tmp/cyclonedds/build \
   && cmake --install /tmp/cyclonedds/build \
   && ldconfig \
   && rm -rf /tmp/cyclonedds

# ---- CZMQ 4.2.1 (high-level C binding for ZeroMQ; required by Zyre) ---------
RUN git clone --depth 1 --branch ${CZMQ_VERSION} \
   https://github.com/zeromq/czmq.git /tmp/czmq \
   && cmake -S /tmp/czmq -B /tmp/czmq/build -G Ninja \
   -DCMAKE_BUILD_TYPE=Release \
   -DCMAKE_INSTALL_PREFIX=/usr/local \
   -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
   -DCZMQ_BUILD_STATIC=ON \
   -DCZMQ_BUILD_TESTS=OFF \
   && cmake --build /tmp/czmq/build \
   && cmake --install /tmp/czmq/build \
   && ldconfig \
   && rm -rf /tmp/czmq

# ---- Zyre v2.0.1 (same version as Ubuntu image) -----------------------------
RUN git clone --depth 1 --branch ${ZYRE_VERSION} \
   https://github.com/zeromq/zyre.git /tmp/zyre \
   && cmake -S /tmp/zyre -B /tmp/zyre/build -G Ninja \
   -DCMAKE_BUILD_TYPE=Release \
   -DCMAKE_INSTALL_PREFIX=/usr/local \
   -DZYRE_BUILD_STATIC=ON \
   -DZYRE_BUILD_TESTS=OFF \
   -DENABLE_DRAFTS=ON \
   && cmake --build /tmp/zyre/build \
   && cmake --install /tmp/zyre/build \
   && ldconfig \
   && rm -rf /tmp/zyre

# ---- CycloneDDS-CXX 0.10.5 (same version as Ubuntu image) ------------------
RUN git clone --depth 1 --branch ${CYCLONEDDS_CXX_VERSION} \
   https://github.com/eclipse-cyclonedds/cyclonedds-cxx.git /tmp/cyclonedds-cxx \
   && cmake -S /tmp/cyclonedds-cxx -B /tmp/cyclonedds-cxx/build -G Ninja \
   -DCMAKE_BUILD_TYPE=Release \
   -DCMAKE_INSTALL_PREFIX=/usr/local \
   -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
   -DBUILD_TESTING=OFF \
   -DBUILD_EXAMPLES=OFF \
   -DCMAKE_PREFIX_PATH=/usr:/usr/local \
   && cmake --build /tmp/cyclonedds-cxx/build \
   && cmake --install /tmp/cyclonedds-cxx/build \
   && ldconfig \
   && rm -rf /tmp/cyclonedds-cxx

# ---- Fix CycloneDDS-CXX 0.10.x headers for GCC 13+ / C++20 -----------------
RUN sed -i 's/~Reference<DELEGATE>()/~Reference()/' \
   /usr/local/include/ddscxx/dds/core/detail/ReferenceImpl.hpp \
   && sed -i 's/~Topic<T>()/~Topic()/' \
   /usr/local/include/ddscxx/dds/topic/detail/TTopicImpl.hpp \
   && sed -i 's/~DataReader<T>()/~DataReader()/' \
   /usr/local/include/ddscxx/dds/sub/detail/TDataReaderImpl.hpp \
   && sed -i 's/~DataWriter<T>()/~DataWriter()/' \
   /usr/local/include/ddscxx/dds/pub/detail/DataWriterImpl.hpp

# ---- Crow v1.2.0 (same version as Ubuntu image) -----------------------------
RUN git clone --depth 1 --branch ${CROW_VERSION} \
   https://github.com/CrowCpp/Crow.git /tmp/crow \
   && cmake -S /tmp/crow -B /tmp/crow/build -G Ninja \
   -DCMAKE_BUILD_TYPE=Release \
   -DCMAKE_INSTALL_PREFIX=/usr/local \
   -DCROW_BUILD_EXAMPLES=OFF \
   -DCROW_BUILD_TESTS=OFF \
   && cmake --build /tmp/crow/build \
   && cmake --install /tmp/crow/build \
   && rm -rf /tmp/crow

RUN ldconfig

RUN echo "alias ll='ls -alhF --color=auto'" >> /etc/bash.bashrc \
  && echo "alias lt='ls -alorth --color=auto'" >> /etc/bash.bashrc 

WORKDIR /workspace
