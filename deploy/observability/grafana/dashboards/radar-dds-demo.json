{
  "title": "RadarDDSDemo - Interface Traffic",
  "uid": "radar-dds-demo",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Messages Sent",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(interface_messages_sent_total)",
          "legendFormat": "sent"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "short" },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Messages Received",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(interface_messages_received_total)",
          "legendFormat": "received"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "short" },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total Bytes Sent",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(interface_bytes_sent_total)",
          "legendFormat": "bytes sent"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "bytes" },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Total Bytes Received",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sum(interface_bytes_received_total)",
          "legendFormat": "bytes received"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "bytes" },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Messages Sent / sec by Topic",
      "datasource": "Prometheus",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (topic) (rate(interface_messages_sent_total[1m]))",
          "legendFormat": "{{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "cps", "custom": { "fillOpacity": 15, "lineWidth": 2 } },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Messages Received / sec by Topic",
      "datasource": "Prometheus",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum by (topic) (rate(interface_messages_received_total[1m]))",
          "legendFormat": "{{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "cps", "custom": { "fillOpacity": 15, "lineWidth": 2 } },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Bytes Sent / sec by Topic",
      "datasource": "Prometheus",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "expr": "sum by (topic) (rate(interface_bytes_sent_total[1m]))",
          "legendFormat": "{{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps", "custom": { "fillOpacity": 15, "lineWidth": 2 } },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Bytes Received / sec by Topic",
      "datasource": "Prometheus",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "expr": "sum by (topic) (rate(interface_bytes_received_total[1m]))",
          "legendFormat": "{{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps", "custom": { "fillOpacity": 15, "lineWidth": 2 } },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Traffic by Interface Type / sec",
      "datasource": "Prometheus",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 22 },
      "description": "Grouped by interface.type (DDS today -- GRPC/ZMQ will appear here automatically once those transports report through the same Observability module).",
      "targets": [
        {
          "expr": "sum by (interface_type) (rate(interface_messages_sent_total[1m]))",
          "legendFormat": "{{interface_type}} sent"
        },
        {
          "expr": "sum by (interface_type) (rate(interface_messages_received_total[1m]))",
          "legendFormat": "{{interface_type}} received"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "cps", "custom": { "fillOpacity": 15, "lineWidth": 2 } },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Live Logs (RadarDDSRadar / RadarDDSWorkstation)",
      "datasource": "Loki",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 31 },
      "description": "GeneralLogger's OtelLogSink forwards every GPINFO/GPWARN/etc. call to the collector, which ships them on to Loki over OTLP.",
      "targets": [
        {
          "expr": "{service_name=~\"RadarDDS.*\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessages": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
