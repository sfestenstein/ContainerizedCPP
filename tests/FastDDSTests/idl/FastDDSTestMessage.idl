/**
 * @file FastDDSTestMessage.idl
 * @brief Test-only IDL fixture for FastDDSTests.
 *
 * Exists solely to exercise fastddsgen_generate() and the FastDDSPublisher/
 * FastDDSSubscriber templates in this test suite. Not a project message type
 * — consumers of FastDDSLib bring their own IDL.
 */

module fastdds_test
{

   struct FastDDSTestMessage
   {
      @key string<64> id;
      double value;
      long sequence_number;
   };

};
