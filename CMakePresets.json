{
   "version": 6,
   "cmakeMinimumRequired": {
      "major": 3,
      "minor": 25,
      "patch": 0
   },
   "configurePresets": [
      {
         "name": "project-default",
         "hidden": true,
         "binaryDir": "${sourceDir}/build/${presetName}",
         "generator": "Ninja",
         "cacheVariables": {
            "CMAKE_CXX_STANDARD": "20",
            "CMAKE_CXX_STANDARD_REQUIRED": "ON",
            "CMAKE_CXX_EXTENSIONS": "OFF",
            "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
         }
      },
      {
         "name": "debug-san",
         "displayName": "Debug with Sanitizers",
         "inherits": "project-default",
         "cacheVariables": {
            "CMAKE_BUILD_TYPE": "Debug",
            "BUILD_TESTS": "ON",
            "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
            "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
            "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined",
            "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=address,undefined"
         }
      },
      {
         "name": "release",
         "displayName": "Release",
         "inherits": "project-default",
         "cacheVariables": {
            "CMAKE_BUILD_TYPE": "Release",
            "BUILD_TESTS": "OFF"
         }
      },
      {
         "name": "debug-coverage",
         "displayName": "Debug Coverage",
         "inherits": "debug-san",
         "cacheVariables": {
            "ENABLE_COVERAGE": "ON",
            "CMAKE_CXX_FLAGS": "--coverage -fprofile-arcs -ftest-coverage",
            "CMAKE_EXE_LINKER_FLAGS": "--coverage",
            "CMAKE_SHARED_LINKER_FLAGS": "--coverage",
            "CMAKE_MODULE_LINKER_FLAGS": "--coverage"
         }
      },
      {
         "name": "ci-linux",
         "displayName": "CI Linux",
         "inherits": "debug-coverage"
      }
   ],
   "buildPresets": [
      {
         "name": "debug-san",
         "configurePreset": "debug-san"
      },
      {
         "name": "release",
         "configurePreset": "release"
      },
      {
         "name": "debug-coverage",
         "configurePreset": "debug-coverage"
      },
      {
         "name": "ci-linux",
         "configurePreset": "ci-linux"
      }
   ],
   "testPresets": [
      {
         "name": "debug-san",
         "configurePreset": "debug-san",
         "output": {
            "outputOnFailure": true,
            "verbosity": "default"
         }
      },
      {
         "name": "debug-coverage",
         "configurePreset": "debug-coverage",
         "output": {
            "outputOnFailure": true,
            "verbosity": "default"
         }
      },
      {
         "name": "ci-linux",
         "configurePreset": "ci-linux",
         "output": {
            "outputOnFailure": true,
            "verbosity": "default"
         }
      }
   ]
}