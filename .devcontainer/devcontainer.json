{
   "name": "ContainerizedCPP Dev",
   "build": {
      "dockerfile": "../Dockerfile",
      "context": ".."
   },
   "remoteEnv": {
      "CC": "${containerEnv:IMAGE_DEFAULT_CC}",
      "CXX": "${containerEnv:IMAGE_DEFAULT_CXX}"
   },
   "workspaceFolder": "/workspaces/ContainerizedCPP",
   "mounts": [
      "source=containerizedcpp-build-ubuntu,target=/workspaces/ContainerizedCPP/build,type=volume"
   ],
   "remoteUser": "root",
   "postCreateCommand": "cmake --version && ninja --version && g++ --version",
   "customizations": {
      "vscode": {
         "extensions": [
            "ms-vscode.cpptools",
            "ms-vscode.cmake-tools",
            "github.copilot",
            "github.copilot-chat"
         ],
         "settings": {
            "cmake.configureSettings": {},
            "cmake.configureEnvironment": {
               "CC": "${containerEnv:IMAGE_DEFAULT_CC}",
               "CXX": "${containerEnv:IMAGE_DEFAULT_CXX}"
            },
            "cmake.buildEnvironment": {
               "CC": "${containerEnv:IMAGE_DEFAULT_CC}",
               "CXX": "${containerEnv:IMAGE_DEFAULT_CXX}"
            },
            "cmake.useCMakePresets": "always",
            "cmake.defaultConfigurePreset": "release",
            "cmake.defaultBuildPreset": "release",
            "cmake.defaultTestPreset": "debug-san",
            "editor.tabSize": 3,
            "editor.insertSpaces": true
         }
      }
   }
}